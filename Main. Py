class Opportunity:

    def __init__(
        self,
        name,
        description,
        estimated_profit,
        cost=0
    ):

        self.name = name
        self.description = description
        self.estimated_profit = float(
            estimated_profit
        )
        self.cost = float(cost)

    @property
    def score(self):

        # High profit and zero cost are preferred.
        return (
            self.estimated_profit * 10
            - self.cost * 5
        )


