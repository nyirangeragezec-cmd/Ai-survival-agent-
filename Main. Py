def db():
    connection = sqlite3.connect(
        DB_FILE,
        check_same_thread=False
    )

    connection.row_factory = sqlite3.Row

    return connection


def initialize_database():

    connection = db()
    cursor = connection.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS wallet (
            id INTEGER PRIMARY KEY CHECK(id = 1),
            balance REAL NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS transactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            kind TEXT NOT NULL,
            amount REAL NOT NULL,
            description TEXT,
            created_at TEXT NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS opportunities (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            description TEXT,
            estimated_profit REAL NOT NULL,
            cost REAL NOT NULL,
            legal INTEGER NOT NULL,
            status TEXT NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS orders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            product TEXT NOT NULL,
            price REAL NOT NULL,
            customer TEXT,
            status TEXT NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS actions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            action TEXT NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS payouts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            amount REAL NOT NULL,
            destination TEXT NOT NULL,
            status TEXT NOT NULL,
            provider_reference TEXT,
            created_at TEXT NOT NULL
        )
    """)

    existing = cursor.execute(
        "SELECT COUNT(*) FROM wallet"
    ).fetchone()[0]

    if existing == 0:

        cursor.execute(
            "INSERT INTO wallet(id, balance) VALUES(1, ?)",
            (STARTING_BALANCE,)
        )

    connection.commit()
    connection.close()


# ------------------------------------------------
# MONEY LEDGER
# ------------------------------------------------

def get_balance():

    connection = db()

    row = connection.execute(
        "SELECT balance FROM wallet WHERE id=1"
    ).fetchone()

    connection.close()

    return float(row["balance"])


def add_income(amount, description):

    if amount <= 0:
        raise ValueError(
            "Income must be greater than zero."
        )

    connection = db()

    connection.execute(
        "UPDATE wallet SET balance = balance + ? WHERE id=1",
        (amount,)
    )

    connection.execute("""
        INSERT INTO transactions
        (kind, amount, description, created_at)
        VALUES (?, ?, ?, ?)
    """, (
        "income",
        amount,
        description,
        now()
    ))

    connection.commit()
    connection.close()

    log.info(
        "Income recorded: $%.2f",
        amount
    )


def add_expense(amount, description):

    if amount <= 0:
        raise ValueError(
            "Expense must be greater than zero."
        )

    if amount > MAX_SINGLE_EXPENSE:
        raise PermissionError(
            "Expense blocked by zero-budget safety policy."
        )

    balance = get_balance()

    if amount > balance:
        raise PermissionError(
            "Insufficient balance."
        )

    connection = db()

    connection.execute(
        "UPDATE wallet SET balance = balance - ? WHERE id=1",
        (amount,)
    )

    connection.execute("""
        INSERT INTO transactions
        (kind, amount, description, created_at)
        VALUES (?, ?, ?, ?)
    """, (
        "expense",
        amount,
        description,
        now()
    ))

    connection.commit()
    connection.close()


