def now():

    return datetime.now(
        timezone.utc
    ).isoformat()


# ------------------------------------------------
# ACTION LIMIT
# ------------------------------------------------

def actions_today():

    connection = db()

    today = datetime.now(
        timezone.utc
    ).date().isoformat()

    count = connection.execute(
        """
        SELECT COUNT(*)
        FROM actions
        WHERE created_at LIKE ?
        """,
        (today + "%",)
    ).fetchone()[0]

    connection.close()

    return count


def record_action(action):

    if actions_today() >= MAX_DAILY_ACTIONS:

        raise RuntimeError(
            "Daily action limit reached."
        )

    connection = db()

    connection.execute("""
        INSERT INTO actions(action, created_at)
        VALUES (?, ?)
    """, (
        action,
        now()
    ))

    connection.commit()
    connection.close()


