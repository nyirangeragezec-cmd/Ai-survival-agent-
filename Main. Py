def ask_ai(question):

    if not AI_API_KEY or not AI_API_URL:

        return (
            "No external AI provider configured. "
            "Using built-in strategy."
        )

    try:

        response = requests.post(
            AI_API_URL,
            headers={
                "Authorization":
                    f"Bearer {AI_API_KEY}",
                "Content-Type":
                    "application/json"
            },
            json={
                "input": question
            },
            timeout=20
        )

        response.raise_for_status()

        data = response.json()

        return data.get(
            "output",
            str(data)
        )

    except Exception as error:

        log.warning(
            "AI provider unavailable: %s",
            error
        )

        return (
            "AI provider unavailable. "
            "Built-in strategy remains active."
        )


