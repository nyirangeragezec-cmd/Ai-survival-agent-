def create_order(
    product_id,
    customer
):

    product = get_product(
        product_id
    )

    if not product:

        raise ValueError(
            "Product not found."
        )

    connection = db()

    cursor = connection.execute("""
        INSERT INTO orders
        (
            product,
            price,
            customer,
            status,
            created_at
        )
        VALUES (?, ?, ?, ?, ?)
    """, (
        product["name"],
        product["price"],
        customer,
        "pending_payment",
        now()
    ))

    order_id = cursor.lastrowid

    connection.commit()
    connection.close()

    return order_id


def mark_order_paid(
    order_id,
    amount
):

    connection = db()

    order = connection.execute(
        "SELECT * FROM orders WHERE id=?",
        (order_id,)
    ).fetchone()

    if not order:

        connection.close()

        raise ValueError(
            "Order not found."
        )

    if order["status"] == "paid":

        connection.close()

        return False

    if amount < order["price"]:

        connection.close()

        raise ValueError(
            "Payment amount is below order price."
        )

    connection.execute(
        """
        UPDATE orders
        SET status='paid'
        WHERE id=?
        """,
        (order_id,)
    )

    connection.commit()
    connection.close()

    add_income(
        amount,
        f"Order #{order_id} - {order['product']}"
    )

    return True


# ------------------------------------------------
# PAYOUT
# ------------------------------------------------

def payout_ready():

    return get_balance() >= PAYOUT_THRESHOLD


def create_payout_request():

    balance = get_balance()

    if balance < PAYOUT_THRESHOLD:

        return {
            "success": False,
            "reason":
                f"Balance ${balance:.2f} "
                f"is below ${PAYOUT_THRESHOLD:.2f}."
        }

    # IMPORTANT:
    # This creates a payout REQUEST only.
    # It does not pretend that money was sent.
    #
    # A real payment provider must be connected here.

    connection = db()

    cursor = connection.execute("""
        INSERT INTO payouts
        (
            amount,
            destination,
            status,
            provider_reference,
            created_at
        )
        VALUES (?, ?, ?, ?, ?)
    """, (
        balance,
        OWNER_PHONE,
        "awaiting_payment_provider",
        None,
        now()
    ))

    payout_id = cursor.lastrowid

    connection.commit()
    connection.close()

    return {
        "success": True,
        "payout_id": payout_id,
        "amount": balance,
        "destination": OWNER_PHONE,
        "status":
            "awaiting_payment_provider"
    }


# ------------------------------------------------
# SURVIVAL DECISION ENGINE
# ------------------------------------------------

class SurvivalAgent:

    def __init__(self):

        self.running = False

    def choose_best_opportunity(self):

        opportunities = (
            generate_opportunities()
        )

        if not opportunities:

            return None

        return opportunities[0]

    def analyze(self):

        best = (
            self.choose_best_opportunity()
        )

        if not best:

            return {
                "decision": "stop",
                "reason":
                    "No legal opportunity found."
            }

        return {
            "decision": "pursue",
            "name": best.name,
            "description":
                best.description,
            "estimated_profit":
                best.estimated_profit,
            "required_cost":
                best.cost,
            "score":
                best.score
        }

    def run_cycle(self):

        record_action(
            "survival_cycle"
        )

        balance = get_balance()

        log.info(
            "Current balance: $%.2f",
            balance
        )

        if payout_ready():

            payout = (
                create_payout_request()
            )

            log.info(
                "Payout status: %s",
                payout
            )

        decision = self.analyze()

        log.info(
            "Best opportunity: %s",
            decision
        )

        return decision

    def start(self):

        self.running = True

        log.info(
            "AI Survival Agent started."
        )

        while self.running:

            try:

                self.run_cycle()

            except Exception as error:

                log.exception(
                    "Agent cycle failed: %s",
                    error
                )

            # Wait before next cycle.
            time.sleep(300)

    def stop(self):

        self.running = False


